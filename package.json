{
  "name": "typescript-cheatsheet",
  "version": "1.0.0",
  "description": "A single-page TypeScript reference for coding interviews.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
